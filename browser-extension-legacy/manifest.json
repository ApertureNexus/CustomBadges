{
  "manifest_version": 3,
  "name": "CustomBadges for Vencord",
  "version": "1.0.0",
  "description": "Adds badges to your profile using Vencord.",
  "content_scripts": [
    {
      "matches": ["*://discord.com/*", "*://*.discord.com/*"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["main.js"],
      "matches": ["*://discord.com/*", "*://*.discord.com/*"]
    }
  ]
}
